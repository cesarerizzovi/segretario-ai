        "jsCode": "const { spawnSync } = require('child_process');\nconst fs = require('fs');\n\nconst binaryItem = $input.first().binary.data;\nconst id = binaryItem.id || '';\nconst realPath = '/home/node/.n8n/binaryData/' + id.replace('filesystem-v2:', '');\n\nif (!fs.existsSync(realPath)) {\n  throw new Error(`File non trovato: ${realPath}`);\n}\n\nconst result = spawnSync('/data/ffmpeg', [\n  '-i', realPath,\n  '-codec:a', 'libmp3lame',\n  '-qscale:a', '2',\n  '/home/node/.n8n-files/voice_output.mp3',\n  '-y'\n]);\n\nconst stderr = result.stderr ? result.stderr.toString().slice(-300) : '';\n\nif (result.status !== 0) {\n  return [{ json: { status: result.status, stderr, realPath } }];\n}\n\nreturn $input.all();"
