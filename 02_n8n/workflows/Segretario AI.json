      ],
      "id": "6f3cd4ff-85a1-413f-a69e-65676b0fdef6",
      "name": "Ricevi messaggio Signal",
      "credentials": {
        "signalApi": {
          "id": "BPJ0ZFQaJfUbDTXz",
          "name": "Signal account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sqlite3 = require('sqlite3').verbose();\n\nconst item = $input.first().json;\n\nconst signalMessageId = String(item.envelope?.timestamp || Date.now());\nconst testoOriginale = item.messageText || item.envelope?.dataMessage?.message || '';\nconst tipo = (item.attachments && item.attachments.length > 0) ? 'vocale' : 'testo';\n\nconst giorniSettimana = ['domenica','lunedì','martedì','mercoledì','giovedì','venerdì','sabato'];\nconst oggi = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Rome' }));\nconst righe = [];\n\nfor (let i = 1; i <= 7; i++) {\n  const d = new Date(oggi);\n  d.setDate(oggi.getDate() + i);\n  const nome = giorniSettimana[d.getDay()];\n  const anno = d.getFullYear();\n  const mese = String(d.getMonth() + 1).padStart(2, '0');\n  const giorno = String(d.getDate()).padStart(2, '0');\n  righe.push(`- ${nome}: ${anno}-${mese}-${giorno}`);\n}\n\nconst giornoOggi = oggi.getDay();\nconst lunediQuesta = new Date(oggi);\nlunediQuesta.setDate(oggi.getDate() - giornoOggi + (giornoOggi === 0 ? -6 : 1));\nconst domenicaQuesta = new Date(lunediQuesta);\ndomenicaQuesta.setDate(lunediQuesta.getDate() + 6);\n\nconst lunediProssima = new Date(lunediQuesta);\nlunediProssima.setDate(lunediQuesta.getDate() + 7);\nconst domenicaProssima = new Date(lunediProssima);\ndomenicaProssima.setDate(lunediProssima.getDate() + 6);\n\nconst fmt = (d) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;\n\nconst mappaDateStringa = righe.join('\\n') +\n  `\\n- questa_settimana: [${fmt(lunediQuesta)} TO ${fmt(domenicaQuesta)}]` +\n  `\\n- prossima_settimana: [${fmt(lunediProssima)} TO ${fmt(domenicaProssima)}]`;\n\nconst storicoConversazione = await new Promise((resolve, reject) => {\n  const db = new sqlite3.Database('/data/segretario.db');\n  db.all(\n    `SELECT role, content FROM conversazione ORDER BY creato_il DESC LIMIT 10`,\n    [],\n    function(err, rows) {\n      db.close();\n      if (err) reject(err);\n      else resolve(rows.reverse());\n    }\n  );\n});\n\nconst isNuovo = await new Promise((resolve, reject) => {\n  const db = new sqlite3.Database('/data/segretario.db');\n  db.run(\n    `INSERT OR IGNORE INTO messages_inbox \n     (signal_message_id, testo_originale, tipo, stato_elaborazione) \n     VALUES (?, ?, ?, 'ricevuto')`,\n    [signalMessageId, testoOriginale, tipo],\n    function(err) {\n      db.close();\n      if (err) reject(err);\n      else resolve(this.changes > 0);\n    }\n  );\n});\n\nif (isNuovo) {\n  await new Promise((resolve, reject) => {\n    const db = new sqlite3.Database('/data/segretario.db');\n    db.run(\n      `INSERT INTO conversazione (role, content) VALUES ('user', ?)`,\n      [testoOriginale],\n      function(err) {\n        db.close();\n        if (err) reject(err);\n        else resolve();\n      }\n    );\n  });\n}\n\nreturn [{\n  json: {\n    signal_message_id: signalMessageId,\n    testo_originale: testoOriginale,\n    tipo: tipo,\n    mittente: item.envelope?.source || '',\n    nome_mittente: item.sourceName || '',\n    is_nuovo: isNuovo,\n    mappa_date: mappaDateStringa,\n    storico_conversazione: storicoConversazione,\n    attachments: item.attachments || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        16
      ],
      "id": "48480e90-fbab-49e3-909e-8c7d5ca3badf",
      "name": "Salva in inbox"
    },
    {
      "parameters": {
        "jsCode": "const https = require('https');\nconst http = require('http');\n\nconst testo = $input.first().json.output;\nconst destinatario = '+393495931632';\n\nconst payload = JSON.stringify({\n  message: testo,\n  number: \"+393517872627\",\n  recipients: [destinatario]\n});\n\nawait new Promise((resolve, reject) => {\n  const options = {\n    hostname: 'segretario_signal_cli',\n    port: 8080,\n    path: '/v2/send',\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      'Content-Length': Buffer.byteLength(payload)\n    }\n  };\n  const req = http.request(options, (res) => {\n    let data = '';\n    res.on('data', chunk => data += chunk);\n    res.on('end', () => {\n      if (res.statusCode === 200 || res.statusCode === 201) {\n        resolve(data);\n      } else {\n        reject(new Error(`Status ${res.statusCode}: ${data}`));\n      }\n    });\n  });\n  req.on('error', reject);\n  req.write(payload);\n  req.end();\n});\n\nreturn [{\n  json: {\n    messaggio_inviato: testo,\n    destinatario: destinatario,\n    stato: 'inviato'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -48
      ],
      "id": "c542de17-cd3a-45a7-9dfd-94d65394b10e",
      "name": "Invia risposta Signal"
    },
    {
      "parameters": {
        "jsCode": "const sqlite3 = require('sqlite3').verbose();\n\nconst inboxId = $('Salva in inbox').item.json.signal_message_id;\nconst testoRisposta = $('Invia risposta Signal').item.json.messaggio_inviato;\nconst intent = 'ai_agent';\n\n// Per blocca_slot salviamo il JSON completo con i dati dello slot\nlet contentDaSalvare = testoRisposta;\n\nawait new Promise((resolve, reject) => {\n  const db = new sqlite3.Database('/data/segretario.db');\n  db.run(\n    `INSERT INTO messages_outbox \n     (inbox_message_id, testo_risposta, tipo, azione_eseguita) \n     VALUES (?, ?, 'testo', ?)`,\n    [inboxId, testoRisposta, intent],\n    function(err) {\n      db.close();\n      if (err) reject(err);\n      else resolve();\n    }\n  );\n});\n\nawait new Promise((resolve, reject) => {\n  const db = new sqlite3.Database('/data/segretario.db');\n  db.run(\n    `INSERT INTO conversazione (role, content) VALUES ('assistant', ?)`,\n    [contentDaSalvare],\n    function(err) {\n      db.close();\n      if (err) reject(err);\n      else resolve();\n    }\n  );\n});\n\nawait new Promise((resolve, reject) => {\n  const db = new sqlite3.Database('/data/segretario.db');\n  db.run(\n    `DELETE FROM conversazione WHERE id NOT IN (\n      SELECT id FROM conversazione ORDER BY creato_il DESC LIMIT 20\n    )`,\n    [],\n    function(err) {\n      db.close();\n      if (err) reject(err);\n      else resolve();\n    }\n  );\n});\n\nreturn [{\n  json: {\n    stato: 'completato',\n    intent: intent,\n    risposta_salvata: testoRisposta\n  }\n}];"
      },
